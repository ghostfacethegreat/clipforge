NEXT_PUBLIC_BUY_ME_A_COFFEE_URL=

# Set this to the public site origin when deploying. Local default is http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local FastAPI backend used by the Next.js /api rewrite.
CLIPFORGE_API_URL=http://127.0.0.1:8000
